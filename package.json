{
  "name": "pickyourtable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --audit-level low",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server db/migrate.ts",
    "db:seed": "tsx --conditions=react-server db/seed.ts",
    "db:reset": "tsx --conditions=react-server db/seed.ts --reset"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.1",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "camera-controls": "3.1.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "geist": "1.8.1",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "postmark": "5.1.0",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "three": "0.186.1",
    "vaul": "1.1.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
