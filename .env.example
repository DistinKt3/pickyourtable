# Copy to .env.local (pnpm run setup does this for you and fills APP_SECRET).
# Never commit real secrets. Production values live in the host's environment settings.

DATABASE_URL=postgres://pyt:pyt_local_only@127.0.0.1:54329/pyt
APP_URL=http://localhost:3000
# 32+ random characters. Signs manage links and hold tokens.
APP_SECRET=

# Payments: "sim" runs a local Stripe simulator; "stripe" uses real Stripe test mode.
# Test-mode keys only: the app refuses sk_live_ and pk_live_ keys.
PAYMENTS_MODE=sim
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNT_ID=

# Email: "dev" stores mail for the /dev/mail inbox; "postmark" sends through Postmark.
EMAIL_MODE=dev
POSTMARK_SERVER_TOKEN=
# Sending address only; the venue's name is used as the sender name.
EMAIL_FROM=bookings@pyt.example

# Cloudflare Turnstile. The defaults are Cloudflare's public always-pass test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_MODE=live

# Simulated payments only: async (default), inline or manual webhook delivery.
SIM_WEBHOOK_DELIVERY=async

# Protects the scheduled job endpoints (/api/jobs/*).
CRON_SECRET=
# Run the 30-second hold-expiry job inside the server process (local only).
JOBS_INPROCESS=1
# Which client-IP header to trust: vercel | xff | none
TRUST_PROXY=none
# Extra origins allowed to frame the guest widget, comma-separated.
EMBED_ALLOWED_ORIGINS=
